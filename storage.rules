rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Pandal photos restricted to pandalPhotos/{pandalId}/{photoId}
    match /pandalPhotos/{pandalId}/{photoId} {
      allow read: if true;
      // Require authenticated user and allow image uploads up to 10MB
      allow create: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if request.auth != null;
    }
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
