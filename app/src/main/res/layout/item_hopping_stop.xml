<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipToPadding="false">

    <!-- Visual Route Connector between Stops (Shown for stops after index 0) -->
    <LinearLayout
        android:id="@+id/routeConnectorLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="34dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <!-- Vertical route connector line with dot -->
        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="@color/primary" />

        <!-- Distance pill along the route connector -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            app:cardBackgroundColor="@color/surface_floating"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/connectorLegDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="↓ 2.4 km"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Main Stop Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stopCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="3dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <!-- Order Index Badge -->
            <TextView
                android:id="@+id/stopIndex"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_badge_circle"
                android:backgroundTint="@color/surface_variant"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Type Icon Container -->
            <FrameLayout
                android:id="@+id/stopTypeIconContainer"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_badge_circle"
                android:backgroundTint="@color/surface_variant">

                <ImageView
                    android:id="@+id/stopTypeIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Type"
                    android:src="@drawable/ic_pandal_icon"
                    app:tint="@color/primary" />
            </FrameLayout>

            <!-- Stop Info: Name & Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stopName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stopArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Remove Button -->
            <ImageButton
                android:id="@+id/removeStopButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove stop"
                android:padding="7dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_tertiary" />

            <!-- Drag Handle -->
            <ImageView
                android:id="@+id/dragHandle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:contentDescription="Reorder stop"
                android:padding="7dp"
                android:src="@drawable/ic_drag_handle"
                app:tint="@color/text_tertiary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
