<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#400284C7">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#E6F2FC"
                android:endColor="#D6EBFC" />
            <stroke
                android:width="1.5dp"
                android:color="#800284C7" />
        </shape>
    </item>
</ripple>
