<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Warm Mesh Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FFEED4"
                android:centerColor="#FFF7EB"
                android:endColor="#FFFBF2" />
        </shape>
    </item>

    <!-- Top Radiant Header Aura -->
    <item
        android:top="0dp"
        android:bottom="350dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="0.5"
                android:centerY="0.0"
                android:startColor="#30F97E04"
                android:centerColor="#10E52B00"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Subtle Bottom Ambient Grounding Aura -->
    <item
        android:top="400dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="350dp"
                android:centerX="0.5"
                android:centerY="1.0"
                android:startColor="#22E52B00"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
