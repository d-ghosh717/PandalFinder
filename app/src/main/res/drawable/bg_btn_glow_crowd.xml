<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40F97E04">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FFF0DF"
                android:endColor="#FFE4C7" />
            <stroke
                android:width="1.5dp"
                android:color="#99F97E04" />
        </shape>
    </item>
</ripple>
